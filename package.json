{
  "name": "plumdeck",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "docker:start": "colima start plumdeck --cpu 5 --memory 8",
    "docker:stop": "colima stop plumdeck",
    "docker:restart": "colima stop plumdeck && colima start plumdeck --cpu 5 --memory 8",
    "backend:install": "node scripts/project.mjs backend-install",
    "backend:dev": "node scripts/project.mjs backend-dev",
    "db:ui": "duckdb -ui",
    "db:cli": "node scripts/project.mjs backend-tool db-cli",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/project.mjs tauri-stack-dev",
    "dj-engine:build": "node scripts/project.mjs engine-build",
    "dj-engine:stage": "node scripts/project.mjs engine-stage",
    "tauri:build:performance": "node scripts/project.mjs app-build",
    "release": "node scripts/project.mjs release",
    "pre-release": "node scripts/project.mjs pre-release",
    "restore:db": "node scripts/project.mjs backend-tool restore",
    "backup:db": "node scripts/project.mjs backend-tool backup",
    "log:watch": "node scripts/project.mjs backend-tool log-watch",
    "local:restore-db": "node scripts/project.mjs backend-tool local-restore",
    "prod:clean-db": "node scripts/project.mjs backend-tool clean-db",
    "prod:clean-db-w": "node scripts/project.mjs backend-tool clean-wal",
    "prod:restore-db": "node scripts/project.mjs backend-tool prod-restore",
    "test:backend": "node scripts/project.mjs backend-test",
    "junction:signal:dev": "pnpm --dir services/junction-signaling build && pnpm --dir services/junction-signaling dev",
    "junction:test:contract": "pnpm --dir services/junction-signaling build && pnpm --dir services/junction-signaling test && node --experimental-strip-types --test src/services/junction/control-boundary.test.mjs src/services/junction/exchange-actions.test.mjs src/services/junction/roster-model.test.mjs src/services/junction/program-mixer.test.mjs src/services/junction/turn-state.test.mjs src/services/midi/junction-channel.test.mjs src/services/junction/share-musics/automation.test.mjs src/services/play-drag-routing.test.mjs",
    "junction:test:manual": "node --test native/mixxx-engine-host/tests/junction/manual-runtime.test.mjs",
    "junction:test:integration": "pnpm --dir services/junction-signaling build && node --test native/mixxx-engine-host/tests/junction/runtime.test.mjs",
    "junction:test:audio": "node scripts/project.mjs junction-test program-output",
    "junction:test:ui": "tsc --noEmit && node --experimental-strip-types --test src/services/junction/control-boundary.test.mjs src/services/junction/exchange-actions.test.mjs src/services/junction/roster-model.test.mjs src/services/junction/program-mixer.test.mjs src/services/junction/turn-state.test.mjs src/services/midi/junction-channel.test.mjs src/services/junction/share-musics/automation.test.mjs src/services/play-drag-routing.test.mjs",
    "junction:test:network": "pnpm --dir services/junction-signaling build && node scripts/project.mjs junction-test media-transport && pnpm --dir services/junction-signaling test",
    "package": "node scripts/project.mjs package",
    "backend:build": "node scripts/project.mjs backend-build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.4.2",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-lrc": "^3.2.1",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
